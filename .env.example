# Copia este archivo a .env (en esta misma carpeta) y llena los valores. El .env nunca se sube a git.
# Las variables sin valor son obligatorias o desactivan su función si se dejan vacías; las comentadas
# tienen un valor por defecto en app/settings/ y solo hace falta descomentarlas para cambiarlo.

# --- Base de datos (Neon). Obligatorias: sin ellas la app no arranca
# Local y migraciones: endpoint directo (sin "-pooler"). En Render: el endpoint "-pooler"
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_DB=
# POSTGRES_PORT=5432
# POSTGRES_SSL_MODE=require

# --- Sesión. Obligatorias
# Secreto largo y aleatorio, python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
OTP_EXPIRE_MINUTES=10
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
# OTP_MAX_ATTEMPTS=5
# OTP_LENGTH=6
# PASSWORD_MIN_LENGTH=8
# PASSWORD_MAX_LENGTH=128

# --- Servidor gRPC (detrás de Envoy en el mismo contenedor)
# GRPC_HOST=127.0.0.1
# GRPC_PORT=50051
# GRPC_SHUTDOWN_GRACE_SECONDS=5.0
# Lo usa solo el contenedor: tiempo de Envoy para conectar con grpcio
# ENVOY_CONNECT_TIMEOUT=1s

# --- Correo (Resend). Sin la API key, enviar falla con EMAIL_DELIVERY_FAILED
RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_TIMEOUT_SECONDS=15
# EMAIL_DNS_TIMEOUT_SECONDS=5

# --- Almacenamiento de objetos de Neon (compatible con S3, buckets privados)
# Sin credenciales, subir archivos responde STORAGE_UNAVAILABLE
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_IMAGES_BUCKET=images
# Buckets privados del servidor gRPC (URLs firmadas). Sin ellos no sube ni lee archivos
S3_PRIVATE_IMAGES_BUCKET=
S3_PRIVATE_VIDEOS_BUCKET=

# --- Videos y avatares
# MAX_VIDEO_UPLOAD_BYTES=104857600
# MAX_VIDEO_DURATION_SECONDS=40
# MAX_AVATAR_UPLOAD_BYTES=1000000
# VIDEO_CONSENT_VERSION=1
# SIGNED_UPLOAD_URL_EXPIRE_SECONDS=900
# UPLOAD_TICKET_EXPIRE_SECONDS=3600
# SIGNED_READ_URL_EXPIRE_SECONDS=300

# --- Listados paginados
# PAGE_SIZE_DEFAULT=20
# PAGE_SIZE_MAX=100

# --- Deportistas
# ATHLETE_MIN_AGE_YEARS=5
# ATHLETE_MAX_AGE_YEARS=100
# Estatura y peso admitidos en la ficha; fuera del rango es casi siempre una unidad equivocada
# ATHLETE_MIN_HEIGHT_CM=80
# ATHLETE_MAX_HEIGHT_CM=250
# ATHLETE_MIN_WEIGHT_KG=15
# ATHLETE_MAX_WEIGHT_KG=250

# --- Chat. El modelo y la API key de Gemini se configuran en la IA, no aquí
# CHAT_MESSAGE_MAX_CHARS=1000
# CHAT_RATE_LIMIT_PER_USER_PER_HOUR=20
# CHAT_RATE_LIMIT_GLOBAL_PER_MINUTE=8

# --- Niveles de riesgo: cortes del puntaje que calcula la IA
# RISK_LEVEL_MODERATE=0.33
# RISK_LEVEL_HIGH=0.66

# --- Microservicio de IA (gRPC). URL y token sin valor por defecto: sin ellos el backend no arranca
# AI_SERVICE_URL=https://kinesiapp-ia.onrender.com
AI_SERVICE_TOKEN=
# AI_TRANSPORT=grpc-web
# Solo con AI_TRANSPORT=grpc, donde AI_SERVICE_URL es host:puerto (en Container Apps, <fqdn>:443)
# AI_GRPC_TLS=true
# AI_CONNECT_TIMEOUT_SECONDS=10
# AI_WAKE_UP_TIMEOUT_SECONDS=60
# AI_WAKE_UP_RETRY_INTERVAL_SECONDS=2
# AI_WAKE_UP_CALL_TIMEOUT_SECONDS=15
# AI_ASSISTANT_TIMEOUT_SECONDS=90
# AI_ASSISTANT_ATTEMPTS=2

# --- Procesamiento de análisis (AnalysisService). Valores medidos con la IA en Azure (1 vCPU)
# ANALYSIS_STREAM_TIMEOUT_SECONDS=180
# ANALYSIS_MAX_ATTEMPTS=4
# ANALYSIS_RETRY_INITIAL_DELAY_SECONDS=5
# ANALYSIS_RETRY_BACKOFF_FACTOR=2
# ANALYSIS_RETRY_MAX_DELAY_SECONDS=60
# ANALYSIS_MAX_CONCURRENCY=1
# ANALYSIS_PROGRESS_PERSIST_INTERVAL_SECONDS=2
# Tiene que superar AI_WAKE_UP_TIMEOUT_SECONDS + ANALYSIS_STREAM_TIMEOUT_SECONDS o el backend no arranca
# ANALYSIS_PROCESSING_LEASE_SECONDS=300
# ANALYSIS_RECOVERY_INTERVAL_SECONDS=60
