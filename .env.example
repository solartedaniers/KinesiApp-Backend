# Copia este archivo a .env (en esta misma carpeta) y llena los valores. El .env nunca se sube a git.
# Las variables sin valor son obligatorias o desactivan su función si se dejan vacías; las comentadas
# tienen un valor por defecto en app/settings/ y solo hace falta descomentarlas para cambiarlo.

# --- Base de datos (Neon). Obligatorias: sin ellas la app no arranca
# Local y migraciones: endpoint directo (sin "-pooler"). En Render: el endpoint "-pooler"
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_DB=
# POSTGRES_PORT=5432
# POSTGRES_SSL_MODE=require

# --- Sesión. Obligatorias
# Secreto largo y aleatorio, el mismo en el REST y en el gRPC: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
OTP_EXPIRE_MINUTES=10
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
# OTP_MAX_ATTEMPTS=5
# OTP_LENGTH=6
# PASSWORD_MIN_LENGTH=8
# PASSWORD_MAX_LENGTH=128

# --- Servidor gRPC (detrás de Envoy en el mismo contenedor)
# GRPC_HOST=127.0.0.1
# GRPC_PORT=50051
# GRPC_SHUTDOWN_GRACE_SECONDS=5.0
# Lo usa solo el contenedor: tiempo de Envoy para conectar con grpcio
# ENVOY_CONNECT_TIMEOUT=1s

# --- API REST de FastAPI (mientras convive con gRPC)
# Lista JSON, por ejemplo ["https://kinesiapp.vercel.app"]
CORS_ALLOWED_ORIGINS=[]
# CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
# PROJECT_NAME=KinesiApp API
# API_V1_PREFIX=/api/v1

# --- Correo (Resend). Sin la API key, enviar falla con EMAIL_DELIVERY_FAILED
RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_TIMEOUT_SECONDS=15
# EMAIL_DNS_TIMEOUT_SECONDS=5

# --- Almacenamiento de objetos de Neon (compatible con S3, buckets privados)
# Sin credenciales, subir archivos responde STORAGE_UNAVAILABLE
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_VIDEOS_BUCKET=videos
# S3_IMAGES_BUCKET=images
# Buckets privados del servidor gRPC (URLs firmadas). Sin ellos no sube ni lee archivos
S3_PRIVATE_IMAGES_BUCKET=
S3_PRIVATE_VIDEOS_BUCKET=

# --- Videos y avatares
# MAX_VIDEO_UPLOAD_BYTES=104857600
# MAX_VIDEO_DURATION_SECONDS=40
# MAX_AVATAR_UPLOAD_BYTES=1000000
# VIDEO_CONSENT_VERSION=1
# VIDEO_ACCESS_TOKEN_EXPIRE_MINUTES=10
# VIDEO_UPLOAD_TOKEN_EXPIRE_MINUTES=30
# SIGNED_UPLOAD_URL_EXPIRE_SECONDS=900
# UPLOAD_TICKET_EXPIRE_SECONDS=3600
# SIGNED_READ_URL_EXPIRE_SECONDS=300
# Clave del proceso interno que reporta resultados por REST; vacía, ese endpoint rechaza toda llamada
JUMP_ANALYSIS_SERVICE_API_KEY=

# --- Listados paginados
# PAGE_SIZE_DEFAULT=20
# PAGE_SIZE_MAX=100

# --- Deportistas
# ATHLETE_MIN_AGE_YEARS=5
# ATHLETE_MAX_AGE_YEARS=100

# --- Chat (Gemini). Sin la API key, el chat responde ASSISTANT_UNAVAILABLE
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_SECONDS=30.0
# GEMINI_MAX_OUTPUT_TOKENS=1024
# CHAT_MESSAGE_MAX_CHARS=1000
# CHAT_HISTORY_MAX_MESSAGES=10
# CHAT_PROMPT_MAX_REPETITIONS=5
# CHAT_RATE_LIMIT_PER_USER_PER_HOUR=20
# CHAT_RATE_LIMIT_GLOBAL_PER_MINUTE=8

# --- Modelos de pose y detección de personas (rutas por defecto: models/ de este repo)
# POSE_MODEL_PATH=models/pose_landmarker_full.task
# POSE_MODEL_VERSION=mediapipe-pose_landmarker_full-float16-v1
# POSE_MIN_DETECTION_CONFIDENCE=0.5
# PERSON_DETECTOR_MODEL_PATH=models/yolo11n.onnx
# PERSON_DETECTOR_MIN_CONFIDENCE=0.5
# PERSON_CROP_MARGIN=0.25
# PERSON_MIN_RELATIVE_AREA=0.25
# PERSON_TRACK_MIN_IOU=0.2
# PERSON_TRACK_MAX_MISSED_FRAMES=15
# PERSON_TRACK_SMOOTHING=0.5
# LANDMARK_VISIBILITY_THRESHOLD=0.1
# LANDMARK_SMOOTHING_WINDOW_FRAMES=3

# --- Fases del movimiento
# JUMP_HIP_APEX_PROMINENCE=0.08
# JUMP_HIP_APEX_MIN_DISTANCE_SECONDS=0.6
# JUMP_APEX_AIRBORNE_BODY_FRACTION=0.06
# JUMP_AIRBORNE_BODY_FRACTION=0.03
# JUMP_GROUND_WINDOW_SECONDS=1.0
# JUMP_GROUND_PERCENTILE=90.0
# JUMP_LANDING_WINDOW_MS=300
# JUMP_LANDING_END_MARGIN_FRAMES=3
# SQUAT_BOTTOM_MIN_PROMINENCE_DEG=25.0
# SQUAT_BOTTOM_MIN_FLEXION_DEG=50.0
# SQUAT_BOTTOM_MIN_DISTANCE_SECONDS=0.6
# SQUAT_BOTTOM_WINDOW_MS=200
# SQUAT_HINGE_MIN_DURATION_SECONDS=0.3

# --- Modelo de riesgo (umbrales sin validación clínica)
# RISK_MODEL_VERSION=risk-patterns-v1
# RISK_JUMP_KNEE_RIGID_ONSET_DEG=60.0
# RISK_JUMP_KNEE_RIGID_SATURATION_DEG=30.0
# RISK_JUMP_KNEE_DEEP_ONSET_DEG=80.0
# RISK_JUMP_KNEE_DEEP_SATURATION_DEG=100.0
# RISK_JUMP_TRUNK_LEAN_ONSET_DEG=25.0
# RISK_JUMP_TRUNK_LEAN_SATURATION_DEG=45.0
# RISK_JUMP_PATTERNS={"rigid_landing": ["knee_rigid"], "forward_collapse": ["knee_deep", "trunk_lean"], "trunk_lean": ["trunk_lean"]}
# RISK_SQUAT_KNEE_SHALLOW_ONSET_DEG=90.0
# RISK_SQUAT_KNEE_SHALLOW_SATURATION_DEG=80.0
# RISK_SQUAT_TRUNK_LEAN_ONSET_DEG=70.0
# RISK_SQUAT_TRUNK_LEAN_SATURATION_DEG=90.0
# RISK_SQUAT_PATTERNS={"hip_hinge_squat": ["squat_trunk_lean", "squat_knee_shallow"]}
# RISK_LEVEL_MODERATE=0.33
# RISK_LEVEL_HIGH=0.66

# --- Microservicio de IA (gRPC). URL y token sin valor por defecto: sin ellos el backend no arranca
# AI_SERVICE_URL=https://kinesiapp-ia.onrender.com
AI_SERVICE_TOKEN=
# AI_TRANSPORT=grpc-web
# Solo con AI_TRANSPORT=grpc, donde AI_SERVICE_URL es host:puerto (en Container Apps, <fqdn>:443)
# AI_GRPC_TLS=true
# AI_CONNECT_TIMEOUT_SECONDS=10
# AI_WAKE_UP_TIMEOUT_SECONDS=60
# AI_WAKE_UP_RETRY_INTERVAL_SECONDS=2
# AI_WAKE_UP_CALL_TIMEOUT_SECONDS=15
# AI_ASSISTANT_TIMEOUT_SECONDS=90

# --- Procesamiento de análisis (AnalysisService). Valores medidos con la IA en Azure (1 vCPU)
# ANALYSIS_STREAM_TIMEOUT_SECONDS=180
# ANALYSIS_MAX_ATTEMPTS=4
# ANALYSIS_RETRY_INITIAL_DELAY_SECONDS=5
# ANALYSIS_RETRY_BACKOFF_FACTOR=2
# ANALYSIS_RETRY_MAX_DELAY_SECONDS=60
# ANALYSIS_MAX_CONCURRENCY=1
# ANALYSIS_PROGRESS_PERSIST_INTERVAL_SECONDS=2
# ANALYSIS_STALE_AFTER_SECONDS=120
